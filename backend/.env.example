DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/mantenimiento_db
SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# create_admin.py lee la contraseña inicial del admin de la variable de entorno
# ADMIN_PASSWORD (o la pide por consola). No la agregues a este archivo: Settings
# rechaza claves desconocidas. Uso: ADMIN_PASSWORD=... python create_admin.py
