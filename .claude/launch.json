{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && exec venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start", "--", "--host", "0.0.0.0"],
      "port": 4200
    }
  ]
}
